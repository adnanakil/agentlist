# =============================================================================
# AgentGate environment template
# -----------------------------------------------------------------------------
# Copy to `.env` for local dev and fill in real values. `.env` is gitignored —
# NEVER commit real secrets. In production these are set as Railway service
# variables, not from a file. Values shown here are safe placeholders/defaults.
#
# Generate the crypto secrets:
#   ENCRYPTION_KEY  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   SESSION_SECRET  python -c "import secrets; print(secrets.token_urlsafe(48))"
#   HAL_BRIDGE_SECRET / HAL_PROVISION_SECRET  python -c "import secrets; print(secrets.token_urlsafe(32))"
# =============================================================================

# ---- Core infrastructure (all services) -------------------------------------
# Local dev defaults match docker-compose. In prod, Railway injects the real
# managed Postgres/Redis URLs as service variables.
DATABASE_URL=postgresql+asyncpg://agentgate:agentgate@localhost:5432/agentgate
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- Secrets shared across services -----------------------------------------
# Fernet key (urlsafe-base64 of 32 bytes). MUST be identical on web + both
# orchestrators (it encrypts agent credentials and OAuth tokens at rest).
ENCRYPTION_KEY=replace-with-generated-fernet-key
# Web session cookie signing.
SESSION_SECRET=replace-with-random-48-byte-token

# ---- Billing (Stripe) -------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SUCCESS_URL=https://agentgate.com/billing/success
STRIPE_CANCEL_URL=https://agentgate.com/billing/cancel

# ---- Registry (semantic search embeddings) ----------------------------------
OPENAI_API_KEY=sk-...

# ---- Web: phone provisioning (Twilio Verify) --------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
HAL_PROVISION_SECRET=replace-with-random-token

# ---- HAL orchestrator: model providers --------------------------------------
# At least one model provider must be funded. GEMINI is the default main loop;
# set ANTHROPIC for a claude-* main model / failover; GLM is optional (Z.ai).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GLM_API_KEY=
# Model selection (have sane defaults — override only to change tiers):
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_BACKGROUND_MODEL=gemini-3.5-flash
# MODEL_FALLBACKS=claude-sonnet-4-6,gemini-3.1-pro-preview

# ---- HAL orchestrator: messaging bridge -------------------------------------
# Shared secret + URL for the SMS/iMessage bridge that fronts HAL.
# REQUIRED in production: an unset HAL_BRIDGE_SECRET makes the message API
# unauthenticated, so the orchestrator refuses to boot without it.
HAL_BRIDGE_SECRET=replace-with-random-token
HAL_BRIDGE_URL=
PUBLIC_BASE_URL=https://hal-orchestrator-production.up.railway.app
ADMIN_PHONE=

# ---- HAL orchestrator: security / privacy hardening -------------------------
# Dedicated token for the read-only /admin dashboard. Keep it DISTINCT from
# HAL_BRIDGE_SECRET so a leaked dashboard URL can't be replayed as bridge auth.
# Unset -> falls back to HAL_BRIDGE_SECRET (single-secret deploys still work).
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
# web_fetch/browser refuse URLs resolving to private/loopback/internal hosts
# (SSRF guard). Set true ONLY on a trusted single-tenant self-host.
ALLOW_PRIVATE_NETWORK_FETCH=false
# Log the actual text of messages/memories/reminders (default false = metadata
# only). Leave false in production; flip true locally to debug content.
LOG_MESSAGE_CONTENT=false

# ---- HAL orchestrator: per-user message quota (free tier -> paid) ------------
# Free user-initiated messages per calendar month, per 1:1 user. Over the cap,
# HAL replies with the funding link instead of running the model. Heartbeats and
# group chats are never metered; the admin phone is exempt. 0 = no cap (default).
# Recommended starting point when you go live: 40.
FREE_MESSAGE_LIMIT=0
# Funding link shown at the cap — a Stripe Checkout / payment-link URL. On an
# iPhone the checkout page offers Apple Pay as a one-tap option. Unset -> a
# graceful "coming soon" message with no link. HAL appends a signed
# client_reference_id so a completed payment maps back to the paying user.
PAYMENT_URL=
# Stripe webhook signing secret (whsec_...) for POST /api/stripe/webhook. Set it
# to auto-unlock a user the instant they pay (checkout.session.completed lifts
# their cap + texts them). Unset -> unlock manually via POST /api/admin/grant.
STRIPE_WEBHOOK_SECRET=
# Stripe secret key (sk_...) — only needed if you later add dynamic per-user
# checkout sessions via the API. The payment-link flow above doesn't use it.
STRIPE_SECRET_KEY=

# ---- HAL orchestrator: Google OAuth (per-user Calendar + Gmail, read-only) ---
# From a Google Cloud OAuth 2.0 Web client. redirect_uri must be registered on
# that client and point at this service's public /api/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ---- HAL orchestrator: external tool APIs (optional) ------------------------
GOOGLE_MAPS_API_KEY=          # travel_time tool (live-traffic Routes API)
RAPIDAPI_KEY=                 # Airbnb search
BROWSER_SERVICE_URL=          # browser/scrape service URL
# Set the exact same SCRAPER_API_KEY on the browser/scrape Railway service,
# Ephemera, and hal-orchestrator. Callers send it as a Bearer token.
SCRAPER_API_KEY=
# AgentGate marketplace bridge (lets HAL invoke AgentGate agents):
AGENTLIST_ORCHESTRATOR_URL=   # e.g. http://orchestrator.railway.internal:8003
AGENTLIST_GATEWAY_URL=        # fallback, e.g. https://gateway-production-cd14.up.railway.app
AGENTLIST_API_KEY=
AGENTLIST_ACCOUNT_ID=

# ---- Service URLs (local dev; Railway uses *.railway.internal in prod) -------
GATEWAY_URL=http://localhost:8000
REGISTRY_URL=http://localhost:8001
BILLING_URL=http://localhost:8002
ORCHESTRATOR_URL=http://localhost:8003

# ---- Tunables (defaults are fine for most deploys) --------------------------
RATE_LIMIT_PER_MINUTE=100
AGENT_TIMEOUT_SECONDS=300
AGENT_MEMORY_LIMIT_MB=512
AGENT_CPU_LIMIT=1.0
